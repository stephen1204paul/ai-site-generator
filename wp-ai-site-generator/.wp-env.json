{
  "core": "WordPress/WordPress#latest",
  "phpVersion": "8.0",
  "plugins": [
    "."
  ],
  "themes": [
    "https://downloads.wordpress.org/theme/astra.zip",
    "https://downloads.wordpress.org/theme/kadence.zip",
    "https://downloads.wordpress.org/theme/twentytwentyfive.zip"
  ],
  "mappings": {
    "wp-content/mu-plugins": "./tests/mu-plugins",
    "wp-content/uploads": "./tests/uploads"
  },
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SCRIPT_DEBUG": true,
    "WP_ENVIRONMENT_TYPE": "local",
    "WP_DEVELOPMENT_MODE": "plugin",
    "WP_PHP_BINARY": "php",
    "WP_TESTS_DOMAIN": "localhost",
    "WP_TESTS_EMAIL": "admin@example.org",
    "WP_TESTS_TITLE": "Test Blog",
    "WP_TESTS_SKIP_INSTALL": false,
    "WP_AUTO_UPDATE_CORE": false,
    "AUTOMATIC_UPDATER_DISABLED": true,
    "AI_SITE_GENERATOR_DEBUG": true
  },
  "env": {
    "development": {
      "port": 8888,
      "testsPort": 8889,
      "plugins": [
        ".",
        "https://downloads.wordpress.org/plugin/query-monitor.zip",
        "https://downloads.wordpress.org/plugin/debug-bar.zip"
      ],
      "config": {
        "WP_DEBUG": true,
        "WP_DEBUG_LOG": true,
        "WP_DEBUG_DISPLAY": true,
        "SCRIPT_DEBUG": true,
        "WP_DISABLE_FATAL_ERROR_HANDLER": true,
        "WP_ENVIRONMENT_TYPE": "development"
      }
    },
    "tests": {
      "port": 8889,
      "plugins": [
        "."
      ],
      "config": {
        "WP_DEBUG": false,
        "WP_DEBUG_LOG": false,
        "WP_DEBUG_DISPLAY": false,
        "SCRIPT_DEBUG": false,
        "WP_ENVIRONMENT_TYPE": "testing",
        "WP_TESTS_SKIP_INSTALL": false
      },
      "scriptsAfterStart": [
        "wp-env run tests-cli wp user create testuser testuser@example.com --role=editor",
        "wp-env run tests-cli wp user create testadmin testadmin@example.com --role=administrator",
        "wp-env run tests-cli wp option update ai_site_generator_test_mode 1"
      ]
    }
  },
  "lifecycleScripts": {
    "afterStart": "./bin/setup-test-data.sh",
    "afterClean": "./bin/cleanup-test-data.sh",
    "afterDestroy": "./bin/cleanup-test-data.sh"
  }
}