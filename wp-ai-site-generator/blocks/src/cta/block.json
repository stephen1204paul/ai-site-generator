{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "waisg/cta",
	"version": "1.0.0",
	"title": "AI Call to Action",
	"category": "waisg-blocks",
	"icon": "megaphone",
	"description": "AI-generated call-to-action section",
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"align": [ "wide", "full" ]
	},
	"attributes": {
		"title": {
			"type": "string",
			"default": "Ready to Get Started?"
		},
		"description": {
			"type": "string",
			"default": "Join thousands of satisfied customers today"
		},
		"buttonText": {
			"type": "string",
			"default": "Start Now"
		},
		"buttonUrl": {
			"type": "string",
			"default": "#"
		},
		"secondaryButtonText": {
			"type": "string",
			"default": ""
		},
		"secondaryButtonUrl": {
			"type": "string",
			"default": "#"
		},
		"style": {
			"type": "string",
			"default": "centered"
		},
		"aiPrompt": {
			"type": "string",
			"default": ""
		},
		"aiGenerated": {
			"type": "boolean",
			"default": false
		}
	},
	"textdomain": "wp-ai-site-generator",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css"
}