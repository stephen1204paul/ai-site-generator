# WP AI Site Generator Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit your actual .env file to version control

# ============================================
# AI Provider API Keys
# ============================================

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORGANIZATION=org-your-org-id-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_MAX_TOKENS=4000

# Google AI (Gemini) Configuration
GOOGLE_AI_API_KEY=your-google-ai-api-key-here
GOOGLE_AI_MODEL=gemini-pro
GOOGLE_AI_MAX_TOKENS=4000

# Groq Configuration (Optional)
GROQ_API_KEY=gsk-your-groq-api-key-here
GROQ_MODEL=mixtral-8x7b-32768

# Cohere Configuration (Optional)
COHERE_API_KEY=your-cohere-api-key-here
COHERE_MODEL=command-r-plus

# ============================================
# Image Generation Services
# ============================================

# DALL-E Configuration
DALLE_API_KEY=sk-your-dalle-api-key-here
DALLE_MODEL=dall-e-3
DALLE_IMAGE_SIZE=1024x1024
DALLE_IMAGE_QUALITY=standard

# Stability AI Configuration
STABILITY_API_KEY=sk-your-stability-api-key-here
STABILITY_ENGINE=stable-diffusion-xl-1024-v1-0

# Midjourney (via Replicate) Configuration
REPLICATE_API_KEY=your-replicate-api-key-here
MIDJOURNEY_VERSION=latest

# Unsplash API (for stock photos)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here
UNSPLASH_SECRET_KEY=your-unsplash-secret-key-here

# Pexels API (for stock photos)
PEXELS_API_KEY=your-pexels-api-key-here

# ============================================
# Development & Debug Settings
# ============================================

# Environment Type (development, staging, production)
WP_ENVIRONMENT_TYPE=development

# Debug Mode
AI_SITE_GENERATOR_DEBUG=true
AI_SITE_GENERATOR_LOG_LEVEL=debug
AI_SITE_GENERATOR_LOG_FILE=/wp-content/debug.log

# API Request Logging
LOG_API_REQUESTS=true
LOG_API_RESPONSES=true
LOG_API_ERRORS=true

# Performance Monitoring
ENABLE_QUERY_MONITOR=true
ENABLE_DEBUG_BAR=true

# ============================================
# Feature Flags
# ============================================

# Enable/Disable Features
ENABLE_AI_CHAT=true
ENABLE_CONTENT_GENERATION=true
ENABLE_IMAGE_GENERATION=true
ENABLE_THEME_CUSTOMIZATION=true
ENABLE_BLOCK_PATTERNS=true
ENABLE_TEMPLATE_LIBRARY=true
ENABLE_MULTI_LANGUAGE=false
ENABLE_ANALYTICS=false

# Experimental Features
ENABLE_EXPERIMENTAL_FEATURES=false
ENABLE_BETA_PROVIDERS=false
ENABLE_ADVANCED_PROMPTS=false

# ============================================
# Rate Limiting & Quotas
# ============================================

# API Rate Limits (requests per minute)
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_HOUR=1000
API_RATE_LIMIT_PER_DAY=10000

# Content Generation Limits
MAX_PAGES_PER_GENERATION=10
MAX_POSTS_PER_GENERATION=50
MAX_IMAGES_PER_PAGE=5
MAX_REGENERATION_ATTEMPTS=3

# User Quotas (0 = unlimited)
USER_MONTHLY_GENERATION_LIMIT=100
USER_MONTHLY_IMAGE_LIMIT=500
USER_MONTHLY_API_CALLS_LIMIT=5000

# ============================================
# Cache Configuration
# ============================================

# Cache Settings
ENABLE_CACHE=true
CACHE_DRIVER=redis
CACHE_TTL=3600
CACHE_PREFIX=wpaisg_

# Redis Configuration (if using Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ============================================
# Database Settings
# ============================================

# Custom Database Tables
USE_CUSTOM_TABLES=true
DB_TABLE_PREFIX=wpaisg_

# Database Optimization
ENABLE_QUERY_CACHE=true
ENABLE_OBJECT_CACHE=true

# ============================================
# Security Settings
# ============================================

# Security Keys
ENCRYPTION_KEY=generate-a-random-32-character-string-here
API_SIGNATURE_KEY=generate-another-random-32-character-string-here

# API Security
REQUIRE_API_SIGNATURE=true
API_WHITELIST_IPS=
API_BLACKLIST_IPS=

# CORS Settings
ALLOW_CORS=false
CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com

# ============================================
# External Services
# ============================================

# Analytics Services
GOOGLE_ANALYTICS_ID=UA-XXXXX-Y
MIXPANEL_TOKEN=your-mixpanel-token-here
SEGMENT_WRITE_KEY=your-segment-write-key-here

# Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
BUGSNAG_API_KEY=your-bugsnag-api-key-here

# Email Service
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="WP AI Site Generator"

# ============================================
# Webhook Configuration
# ============================================

# Webhook URLs
WEBHOOK_GENERATION_COMPLETE=https://your-webhook-url.com/generation-complete
WEBHOOK_GENERATION_FAILED=https://your-webhook-url.com/generation-failed
WEBHOOK_CONTENT_UPDATED=https://your-webhook-url.com/content-updated

# Webhook Security
WEBHOOK_SECRET=your-webhook-secret-here
WEBHOOK_TIMEOUT=30

# ============================================
# Testing Configuration
# ============================================

# Test Mode
TEST_MODE=false
USE_MOCK_AI_RESPONSES=false
MOCK_RESPONSE_DELAY=1000

# Test API Keys (Never use real keys here)
TEST_OPENAI_API_KEY=test-key-do-not-use-in-production
TEST_ANTHROPIC_API_KEY=test-key-do-not-use-in-production

# ============================================
# Advanced Configuration
# ============================================

# Resource Limits
MAX_EXECUTION_TIME=300
MEMORY_LIMIT=256M

# Background Jobs
ENABLE_BACKGROUND_JOBS=true
BACKGROUND_JOB_QUEUE=database
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY=60

# Content Processing
ENABLE_CONTENT_OPTIMIZATION=true
ENABLE_SEO_OPTIMIZATION=true
ENABLE_IMAGE_OPTIMIZATION=true

# Multi-site Support
ENABLE_MULTISITE_SUPPORT=false
NETWORK_WIDE_SETTINGS=false

# License Configuration
LICENSE_KEY=
LICENSE_EMAIL=
LICENSE_DOMAIN=